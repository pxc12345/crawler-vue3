# 复制为 .env 后使用
# ============================================================
# API 后端地址（开发 npm run dev / 构建 npm run build 共用）
# 切换方式：注释当前行，取消另一行注释，保存后重启 dev 服务
#
# 注意：勿再创建 .env.local —— Vite 会优先读它并覆盖本文件
# ============================================================

# 远程 Render 后端
VITE_API_BASE_URL=https://crawler-vue3.onrender.com/api

# 本地后端（联调时使用）
# VITE_API_BASE_URL=http://127.0.0.1:5000/api
