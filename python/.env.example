# 复制为 .env 并填写 TiDB Cloud Connect 窗口中的真实值
# 允许跨域的前端地址（逗号分隔），部署时加入你的前端域名
# 前端 https://crawler-pro.onrender.com 访问后端时需放行该域名（默认已包含，可按需覆盖）
# CORS_ORIGINS=https://crawler-pro.onrender.com,http://localhost:3000,http://localhost:5173

DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=2TWCEXrYi7VBhDT.root
DB_PASSWORD=从TiDB控制台Reset后复制，注意区分字母I和l
DB_NAME=test
# 从 TiDB Cloud 下载的 CA 证书路径（可选，默认使用 certs/isrgrootx1.pem）
# DB_CA_PATH=C:\test\python\certs\ca.pem
